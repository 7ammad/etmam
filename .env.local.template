# Copy to .env.local and fill as needed.
# Use a LOCAL Supabase DB first; remote/syncing can be added later.

# -----------------------------------------------------------------------------
# Local Supabase (recommended first)
# Run: supabase start  then  supabase status  — copy API URL, anon key, service_role key
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apply schema to local DB: supabase db reset (no remote link or push needed)
# Must match app_config.system_user_id in DB (00008 seeds 00000000-0000-0000-0000-000000000001)
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Optional: remote migrations only when you add a hosted project later
# SUPABASE_ACCESS_TOKEN=   (Dashboard -> Account -> Access Tokens)
# SUPABASE_DB_PASSWORD=    (Dashboard -> Settings -> Database)
# -----------------------------------------------------------------------------

# Optional: scraper/sync (local: API_URL=http://127.0.0.1:3000/api/cron/sync). Generate: pnpm generate:cron-secret
CRON_SECRET=
# Only for CI / deployed app (replace YOUR_APP with your host)
# SCRAPER_API_URL=https://YOUR_APP/api/cron/sync
# APP_BASE_URL=https://YOUR_APP
# NEXT_PUBLIC_APP_URL=https://YOUR_APP

# Optional: Odoo push can be enabled later when credentials are provided
ODOO_BASE_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_PUSH_ENABLED=false
