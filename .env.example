# =============================================================================
# Etmaam CRM Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Supported providers: deepseek, openai
AI_PROVIDER=deepseek

# DeepSeek API Key (if using DeepSeek)
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key

# -----------------------------------------------------------------------------
# Scraper Configuration (Phase 0)
# -----------------------------------------------------------------------------

# Secret token for authenticating cron/scraper API requests
# Generate with: openssl rand -hex 32
CRON_SECRET=your-secure-random-token

# System user ID for scraped tenders
# This UUID identifies the "system" user that owns all scraped tenders
# Default: 00000000-0000-0000-0000-000000000001
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# GitHub Actions Secrets (for CI/CD) - SETUP AFTER DEPLOYMENT
# -----------------------------------------------------------------------------
# ⚠️  NOTE: Only set these up AFTER you've deployed your app!
# 
# For now, test locally with:
#   pnpm scrape:test          # Test scraper only
#   pnpm scrape:run           # Test with local API (requires pnpm dev running)
#
# When ready to deploy:
# 1. Deploy your app (Vercel/Netlify/etc.)
# 2. Get your deployment URL
# 3. Add these secrets in GitHub: Settings → Secrets and variables → Actions
#
# Required secrets:
#   SCRAPER_API_URL - Full URL to the sync endpoint
#     Example: https://your-app.vercel.app/api/cron/sync
#
#   CRON_SECRET - Same as above, for authenticating the scraper
#     Use the same value as CRON_SECRET above
#
# Optional:
#   SLACK_WEBHOOK_URL - For failure notifications
#
# See docs/LOCAL_SCRAPER_TESTING.md for testing guide
# See docs/GITHUB_ACTIONS_SETUP.md for deployment setup
